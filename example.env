# Database Configuration
DB_URL=postgresql://postgres:your_password@db.your_supabase_project.supabase.co:5432/postgres
DB_USER=postgres
DB_PASSWORD=your_supabase_password
DB_NAME=postgres
DB_PORT=5432
DB_SCHEME=public



# API Keys
OPENAI_API_KEY="sk-your-openai-api-key-here"
ELEVEN_LABS_API_KEY="sk_your_eleven_labs_api_key_here"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key-here"
# AGNO_API_KEY="your_agno_api_key_here"

# Docker Image Configuration
IMAGE_NAME=crafty
IMAGE_TAG=v0.0.1
RENDER_DEPLOY_HOOK="https://api.render.com/deploy/srv-your-service-id?key=your-deploy-key"

# Redis Configuration (optional, for caching)
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token"